# Cloudflare Turnstile site key. The default is Cloudflare's "always passes" test key.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Where the contact form posts. Same-origin path in production, absolute URL in e2e.
PUBLIC_CONTACT_ENDPOINT=/api/contact
# Umami analytics; leave empty to omit the script tag.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
