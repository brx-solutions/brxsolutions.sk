---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { t, anchors, locales, localeHome, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Same page in every locale; defaults to the locale home pages. */
  alternates?: Record<Locale, string>;
}
const { locale, alternates = { sk: localeHome('sk'), en: localeHome('en') } } = Astro.props;
const d = t(locale);
const links = [
  [anchors.services, d.nav.services],
  [anchors.stack, d.nav.stack],
  [anchors.experience, d.nav.experience],
  [anchors.projects, d.nav.projects],
  [anchors.own, d.nav.own],
  [anchors.contact, d.nav.contact],
] as const;
---

<header class="sticky top-0 z-10 border-b border-line bg-bg/85 backdrop-blur-[14px]">
  <nav
    aria-label={locale === 'sk' ? 'Hlavná navigácia' : 'Main navigation'}
    class="mx-auto flex min-h-[72px] max-w-page flex-wrap items-center justify-between gap-x-3 gap-y-2 px-4 sm:px-5 md:gap-x-6 md:px-8"
  >
    <a href={localeHome(locale)} class="flex items-center gap-3">
      <Logo />
      <span class="text-[19px] tracking-[-0.02em]"><span class="font-extrabold">BRX</span> <span class="font-medium">Solutions</span></span>
    </a>


    <div
      id="main-nav"
      data-nav
      class="order-4 hidden w-full basis-full flex-col gap-1 pb-4 text-sm font-medium md:order-1 md:flex md:w-auto md:basis-auto md:flex-row md:flex-wrap md:items-center md:gap-7 md:pb-0"
    >
      {links.map(([id, label]) => <a href={`#${id}`} class="py-2 text-muted md:py-0">{label}</a>)}
    </div>

    <div class="order-2 flex items-center gap-2.5 sm:gap-3.5 md:order-3">
    <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-[10px] border border-line-2 text-ink md:hidden"
        aria-controls="main-nav"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only" data-label-open>{d.nav.menuOpen}</span>
        <span class="sr-only hidden" data-label-close>{d.nav.menuClose}</span>
        <Icon name="menu" size={22} class="menu-icon-open" />
        <Icon name="close" size={22} class="menu-icon-close hidden" />
      </button>
      <div
        role="group"
        aria-label={d.nav.langLabel}
        class="inline-flex rounded-full border border-line-2 bg-white/4 p-[3px]"
      >
        {
          locales.map((l) => (
            <a
              href={alternates[l]}
              hreflang={l}
              lang={l}
              data-lang-switch
              aria-current={l === locale ? 'true' : undefined}
              class:list={[
                'inline-flex h-9 min-w-9 items-center justify-center rounded-full px-2 text-xs font-semibold tracking-[0.06em] sm:min-w-11 sm:px-3',
                l === locale ? 'bg-accent text-bg hover:text-bg' : 'text-muted',
              ]}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
      <a
        href={`#${anchors.contact}`}
        class="hidden h-11 items-center rounded-[10px] bg-accent px-[18px] text-sm font-bold text-bg hover:text-bg sm:inline-flex"
      >
        {d.nav.cta}
      </a>
    </div>
  </nav>
</header>

<script src="../scripts/lang-switch.ts"></script>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('hidden', !open);
      nav.classList.toggle('flex', open);
      toggle.querySelector('.menu-icon-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.menu-icon-close')?.classList.toggle('hidden', !open);
      toggle.querySelector('[data-label-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-label-close]')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>
