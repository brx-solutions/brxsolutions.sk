---
export type Icon =
  | 'api' | 'data' | 'legacy' | 'bot' | 'invoice' | 'home'
  | 'arrow' | 'mail' | 'chevron' | 'menu' | 'close';

interface Props {
  name: Icon;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const paths: Record<Icon, string> = {
  api: 'M4 7h16M4 12h16M4 17h10M18 15l2 2-2 2',
  data: 'M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  legacy: 'M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01M14 10v4',
  bot: 'M12 3v3M8 6h8a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V9a3 3 0 0 1 3-3zM9 12h.01M15 12h.01M9 16h6',
  invoice: 'M6 3h9l4 4v14H6zM15 3v4h4M9 12h6M9 16h6',
  home: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z',
  arrow: 'M5 12h14M13 6l6 6-6 6',
  mail: 'M4 6h16v12H4zM4 7l8 6 8-6',
  chevron: 'M6 9l6 6 6-6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6L6 18',
};

const { name, size = 20, class: className, strokeWidth = 2 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  <path d={paths[name]}></path>
</svg>
