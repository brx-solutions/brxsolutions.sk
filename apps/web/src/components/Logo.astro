---
interface Props {
  size?: number;
  fill?: string;
  class?: string;
}
const { size = 38, fill = 'var(--color-accent)', class: className } = Astro.props;
---

<svg role="img" aria-label="BRX Solutions" width={size} height={size} viewBox="0 0 64 64" class={className}>
  <rect width="64" height="64" rx="14" fill={fill}></rect>
  <rect x="15" y="14" width="9" height="36" rx="2.5" fill="#0A0E14"></rect>
  <polyline
    points="31,22 45,32 31,42"
    fill="none"
    stroke="#0A0E14"
    stroke-width="9"
    stroke-linecap="round"
    stroke-linejoin="round"></polyline>
</svg>
