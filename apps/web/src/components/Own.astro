---
import { render } from 'astro:content';
import Section from './Section.astro';
import Icon from './Icon.astro';
import Tag from './Tag.astro';
import Details from './Details.astro';
import { localized } from '../content/queries';
import { t, anchors, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const items = await Promise.all(
  (await localized('own', locale)).map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Section id={anchors.own} no="05" eyebrow={d.own.eyebrow} title={d.own.title} sub={d.own.sub} subMax="max-w-[440px]">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-4">
    {
      items.map(({ entry: { data: o }, Content }) => (
        <article class="flex flex-col gap-4 rounded-card border border-white/10 bg-surface p-7">
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-surface-2 text-accent-light">
              <Icon name={o.icon} size={22} strokeWidth={1.9} />
            </span>
            <span class="font-mono text-xs text-accent-light">{o.status}</span>
          </div>
          <h3 class="m-0 font-display text-[21px] leading-[1.25] font-semibold tracking-[-0.02em]">{o.title}</h3>
          <div class="prose-body text-[15px] leading-[1.6] text-muted">
            <Content />
          </div>
          <div class="flex flex-wrap gap-2">
            {o.tags.map((tag) => (
              <Tag>{tag}</Tag>
            ))}
          </div>
          <Details moreLabel={d.own.more} lessLabel={d.own.less} class="mt-auto">
            <p class="m-0 rounded-xl border border-line bg-bg p-4 text-sm leading-[1.6] text-ink-2">{o.tech}</p>
          </Details>
        </article>
      ))
    }
  </div>
</Section>
