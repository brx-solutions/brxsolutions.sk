---
import Section from './Section.astro';
import Tag from './Tag.astro';
import Details from './Details.astro';
import { localized } from '../content/queries';
import { t, anchors, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const projects = await localized('projects', locale);
---

<Section
  id={anchors.projects}
  no="04"
  eyebrow={d.nav.projects}
  title={d.projects.title}
  sub={d.projects.sub}
  tone="surface"
>
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    {
      projects.map(({ data: p }) => (
        <article class="flex flex-col gap-[18px] rounded-card border border-white/10 bg-bg p-6 md:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="font-mono text-xs text-muted">{p.context}</span>
            <span class="font-mono text-xs text-muted-2">{p.year}</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="font-display text-[44px] leading-none font-bold tracking-[-0.04em] text-white">
              {p.metric}
            </span>
            <span class="text-sm font-medium text-accent-light">{p.metricLabel}</span>
          </div>
          <h3 class="m-0 font-display text-[21px] leading-[1.25] font-semibold tracking-[-0.02em]">
            {p.title}
          </h3>
          <p class="m-0 text-[15px] leading-[1.6] text-muted">{p.problem}</p>
          <div class="grid grid-cols-[3px_1fr] items-stretch gap-3.5">
            <span aria-hidden="true" class="rounded-sm bg-accent" />
            <p class="m-0 text-[15px] leading-[1.55] font-medium text-ink">{p.result}</p>
          </div>
          <div class="flex flex-wrap gap-2">
            {p.tags.map((tag) => (
              <Tag>{tag}</Tag>
            ))}
          </div>
          <Details moreLabel={d.projects.more} lessLabel={d.projects.less} class="mt-auto">
            <div class="flex flex-col gap-2.5 rounded-xl border border-line bg-surface p-[18px]">
              <span class="font-mono text-xs text-accent-light">{d.projects.more}</span>
              <p class="m-0 text-[14.5px] leading-[1.6] text-ink-2">{p.solution}</p>
            </div>
          </Details>
        </article>
      ))
    }
  </div>
  <p class="m-0 text-sm text-muted-2">{d.projects.nda}</p>
</Section>
