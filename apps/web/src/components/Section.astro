---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  sub?: string;
  class?: string;
  label?: string;
}
const { id, title, eyebrow, sub, class: className, label } = Astro.props;
---

<section id={id} class:list={['border-b border-line', className]} aria-label={label}>
  <div class="mx-auto flex max-w-page flex-col gap-11 px-5 py-16 md:px-8 md:py-[104px]">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex max-w-[620px] flex-col gap-3.5">
        {eyebrow && <p class="m-0 font-mono text-[13px] text-accent">{eyebrow}</p>}
        <h2 class="m-0 font-display text-[clamp(34px,3.8vw,52px)] leading-[1.05] font-bold tracking-[-0.035em] whitespace-pre-line">{title}</h2>
        {sub && <p class="m-0 max-w-[400px] text-base leading-[1.6] text-muted">{sub}</p>}
      </div>
      <slot name="aside" />
    </div>
    <slot />
  </div>
</section>
