---
interface Props {
  variant?: 'outline' | 'solid';
}
const { variant = 'solid' } = Astro.props;
---

<span
  class:list={[
    'font-mono text-xs text-ink-2',
    variant === 'outline'
      ? 'rounded-lg border border-line-2 px-2.5 py-1.5'
      : 'rounded-[7px] bg-surface-2 px-[9px] py-[5px]',
  ]}><slot /></span
>
