# Image tag to run. CI publishes the git sha; "dev" is what `docker compose build` produces locally.
# deploy.sh rewrites this line on every roll-out.
IMAGE_TAG=dev
# Set to a git sha to pin the stack there (rollback); empty means "follow main".
PIN_TAG=
GITHUB_REPO=brx-solutions/brxsolutions.sk

# Site
SITE_ORIGIN=https://brxsolutions.sk
STATS_ORIGIN=https://stats.brxsolutions.sk

# Contact API.
# Local defaults use Cloudflare's "always passes" Turnstile test secret and log
# mails to stdout. PRODUCTION MUST set a real TURNSTILE_SECRET_KEY, a RESEND_API_KEY
# and MAIL_TRANSPORT=resend, otherwise the form is unprotected and mail is not sent.
CONTACT_TO=peter.beraxa@gmail.com
CONTACT_FROM=web@brxsolutions.sk
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=
MAIL_TRANSPORT=console
# Submissions per IP per hour (default 5).
RATE_LIMIT_PER_HOUR=5

# Build-time public values for the web image
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=

# Production only (compose.prod.yml)
TUNNEL_TOKEN=
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=
